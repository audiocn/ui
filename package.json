{
  "name": "audiocn",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "brand:build": "node scripts/build-brand-icons.mjs",
    "og:build": "node scripts/build-social-images.mjs",
    "dev": "pnpm examples:build && next dev",
    "build": "pnpm brand:build && pnpm examples:build && pnpm registry:build && next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "registry:build": "shadcn build",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "ultracite check",
    "doctor": "react-doctor --verbose -y --no-score",
    "fix": "ultracite fix",
    "examples:build": "node scripts/build-examples.mjs",
    "test:e2e": "playwright test",
    "test:install": "node scripts/test-install.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@rexa-developer/tiks": "^0.3.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.17",
    "jotai": "^3.0.1",
    "motion": "^13.4.6",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/estree": "^1.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react-doctor": "^0.9.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.12.2",
    "vitest": "^5.0.3"
  }
